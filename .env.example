PORT=3000
PUBLIC_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
FLUXER_CLIENT_ID=
FLUXER_CLIENT_SECRET=
# console, fluxer, stoat, or both
ARIA_PLATFORM=console
# Token for a single platform (fluxer or stoat)
ARIA_TOKEN=
# Tokens for ARIA_PLATFORM=both
ARIA_FLUXER_TOKEN=
ARIA_STOAT_TOKEN=
ARIA_PREFIX=a!
YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Optional absolute path when ffmpeg is not available on PATH.
FFMPEG_PATH=
# Optional: send YouTube traffic through another connection (e.g. home)
YTDLP_PROXY=
# Optional (Docker): Tailscale exit node instead of a manual proxy
TS_AUTHKEY=
TS_EXIT_NODE=
